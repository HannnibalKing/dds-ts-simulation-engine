{
  "name": "dds-ts",
  "version": "0.1.0",
  "description": "Deterministic Distributed Simulation Engine - AI-Takeover Framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./math": {
      "import": "./dist/math/index.js",
      "types": "./dist/math/index.d.ts"
    },
    "./net": {
      "import": "./dist/net/index.js",
      "types": "./dist/net/index.d.ts"
    },
    "./consensus": {
      "import": "./dist/consensus/index.js",
      "types": "./dist/consensus/index.d.ts"
    },
    "./rollback": {
      "import": "./dist/rollback/index.js",
      "types": "./dist/rollback/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify/index.js",
      "types": "./dist/verify/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts",
    "verify": "node dist/tools/determinism-test.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "deterministic",
    "simulation",
    "distributed",
    "lockstep",
    "rollback",
    "consensus"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
